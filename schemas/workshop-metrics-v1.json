{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/workshop-metrics-v1.json",
  "title": "Pathfinder workshop metrics v1",
  "type": "object",
  "required": ["schema_version", "candidate_total", "confidence_high", "confidence_medium", "confidence_low"],
  "properties": {
    "schema_version": { "const": "workshop-metrics-v1" },
    "candidate_total": { "type": "integer", "minimum": 0 },
    "confidence_high": { "type": "integer", "minimum": 0 },
    "confidence_medium": { "type": "integer", "minimum": 0 },
    "confidence_low": { "type": "integer", "minimum": 0 },
    "kpi.confidence.share.high": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.confidence.share.medium": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.confidence.share.low": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.escalation.rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "kpi.harness.precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.harness.recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.harness.recall.high": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.harness.recall.medium": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.harness.recall.low": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.review.backlog": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.review.pending_high": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.review.pending_medium": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.review.pending_low": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.review.accept_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.assess.verdict": { "type": "string" },
    "kpi.assess.submission_kind": { "type": "string", "enum": ["", "tech_spec", "code_snippet"] },
    "kpi.assess.covered": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.assess.unbound": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.assess.stale": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.submission.tech_spec_count": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.submission.code_snippet_count": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.escalation.rate.tech_spec": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.escalation.rate.code_snippet": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.invariant.llm_calls": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.assist.proposal_count": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.assist.prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.assist.completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "kpi.assist.cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "kpi.assist.provider": { "type": "string" },
    "kpi.assist.model": { "type": "string" },
    "kpi.promptfoo.pass_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "promptfoo_mode": { "type": "string" },
    "kpi.evidence.gap_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "kpi.corpus.size": { "type": ["integer", "null"], "minimum": 0 }
  },
  "additionalProperties": true
}
